# Indirizzo pubblico del sito (senza barra finale). Serve per sitemap, link canonici e anteprime social.
NEXT_PUBLIC_SITE_URL=https://www.novamenu.eu
# Indirizzo della dashboard dove i clienti accedono.
NEXT_PUBLIC_APP_URL=https://app.novamenu.eu
# Numero WhatsApp che riceve le richieste di demo (solo cifre, con prefisso).
NEXT_PUBLIC_WHATSAPP=393000000000
# Strumenti di statistica e marketing: si caricano solo dopo il consenso nel banner dei cookie.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Funzione Supabase che salva le scelte sui cookie (tabella consensi_cookie).
NEXT_PUBLIC_CONSENSO_ENDPOINT=
